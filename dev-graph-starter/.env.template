# Copy to .env at the office and fill in.

# Required
ANTHROPIC_API_KEY=

# Absolute path to your real recommendation backend repo (git working tree).
# The Coder node creates git worktrees off HEAD in a separate location so
# this working tree is never modified.
DEV_GRAPH_WORKSPACE=/absolute/path/to/your/repo

# Optional: where per-task worktrees are created.
# Default: ~/.dev_graph/worktrees
# DEV_GRAPH_WORKTREES=/tmp/dev_graph_worktrees

# Optional: where the SQLite checkpointer stores durable state.
# Default: ~/.dev_graph/checkpoints.sqlite
# DEV_GRAPH_CHECKPOINT_DB=~/.dev_graph/checkpoints.sqlite
